# Safe local defaults. Copy to .env for local development; never commit .env.

PORT=8787
HOST=127.0.0.1
AI_MEMORY_DIR=./examples/sample-vault
ALLOWED_HOSTS=localhost,127.0.0.1

# Authentication controls.
# Auth is required by default. Replace both tokens with long random values.
MCP_AUTH_REQUIRED=true
MCP_READ_TOKEN=replace-with-long-random-read-token
MCP_WRITE_TOKEN=replace-with-long-random-write-token

# Write tools are disabled by default. Set true only for trusted clients.
AI_MEMORY_WRITE_ENABLED=false

# Optional local-only development escape hatch:
# MCP_AUTH_REQUIRED=false

# Planned privacy controls. Not implemented yet.
LOG_CONTENT=false
MASK_EMAILS=true
MASK_PHONE_NUMBERS=true
MAX_SNIPPET_CHARS=220
